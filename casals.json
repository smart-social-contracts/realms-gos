{
  "version": 2,
  "name": "realms-product",
  "description": "Realms product orchestra: the marketplace, the fleet file registry (extensions, codices, catalogs), and the RLM token and NFT canisters.",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "marketplace_host": "",
      "casals_host": "",
      "principals": {
        "operator": "$deployer"
      },
      "cycles": {
        "budget_tc": 300
      }
    },
    "production": {
      "network": "ic",
      "$comment": "operator is prod-identity (YubiKey). Deploy through an icp delegation from it. DNS lives in the Cloudflare zone realmsgos.org; the API token is read from $CLOUDFLARE_API_TOKEN, never written here.",
      "dns": {
        "provider": "cloudflare",
        "zone": "realmsgos.org",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "marketplace_host": "realmsgos.org",
      "casals_host": "casals.realmsgos.org",
      "principals": {
        "operator": "$deployer",
        "$comment_deployer": "The identity that ran casals up. It is a controller of the governance multisig only.",
        "deployer": "$deployer"
      },
      "cycles": {
        "budget_tc": 20
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "store": {
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "realms-product"
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig",
        "$deployer"
      ]
    }
  },
  "domains": [
    {
      "host": "$env.marketplace_host",
      "canister": "marketplace-frontend"
    },
    {
      "host": "$env.casals_host",
      "canister": "casals-frontend"
    }
  ],
  "registry": {
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "release:smart-social-contracts/Casals@v0.4.0:casals_backend.wasm.gz",
        "sha256": "dc0f557f6b7cde042e643548e1c8ab4a5ce03748c86001bffccbb2bf9486ec1a"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "release:smart-social-contracts/Casals@v0.4.0:certified-assets@0.3.0.wasm.gz",
        "sha256": "75df75f39763077fd0333b4ac46ba03b2b23ec313fa85f79a2097bd98bb363d1"
      },
      {
        "family": "certified-assets",
        "version": "1.0.0",
        "source": "release:smart-social-contracts/Casals@v0.4.0:certified-assets@1.0.0.wasm.gz",
        "sha256": "63d122d0149a29f4e48603efdd7d2bce656a6a83bac1e3207897c68e8e225bb6"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "release:smart-social-contracts/Casals@v0.4.0:orchestration-multisig@1.6.0.wasm.gz",
        "sha256": "c8d3adecf9bea8d9e7811cfa5d9eda8f61723c770f85132b91c8b2cffb37974f"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "release:smart-social-contracts/file-registry@v0.1.1:file_registry.wasm.gz",
        "sha256": "05ec042b1ed6944db2b3b69a781938f5f6ac5d7353490413b8b02b2149bd58e5"
      },
      {
        "family": "marketplace-backend",
        "version": "main",
        "source": "release:smart-social-contracts/realms-gos@v0.6.3:marketplace-backend-v0.6.3.wasm.gz",
        "sha256": "903177dd151c0c771163f95d820c3f012626c42627c63f8b79a182064b81fbb4"
      },
      {
        "family": "token-backend",
        "version": "0.1.0",
        "source": "release:smart-social-contracts/realms-gos@v0.6.3:token-backend-v0.6.3.wasm.gz",
        "sha256": "a1734ad2ec260ce85e541f860dbcaf8c846423709177587c7e5f70adc47e461a"
      },
      {
        "family": "nft-backend",
        "version": "0.1.0",
        "source": "release:smart-social-contracts/realms-gos@v0.6.3:nft-backend-v0.6.3.wasm.gz",
        "sha256": "abea08d97de800d4e299545be786dd02c9c6a7d93aaccc3770a08c213dfa484b"
      }
    ],
    "bundles": [
      {
        "path": "frontend/marketplace-assets/main",
        "source": "release:smart-social-contracts/realms-gos@v0.6.3:marketplace-frontend-v0.6.3.tar.gz",
        "sha256": "8a9cf40422fb910e9a8e66bc7654213ac53411734c587879cd18acf6ffb257fb"
      },
      {
        "path": "frontend/file-registry-assets/main",
        "source": "release:smart-social-contracts/file-registry@v0.1.0:file_registry_frontend.tar.gz",
        "sha256": "7ba94633f56ee83418ab3d91cc5b9a952a504a6694235b261cbabb35e728a05c"
      },
      {
        "path": "frontend/casals-ui/main",
        "source": "release:smart-social-contracts/Casals@v0.4.0:casals_frontend.tar.gz",
        "sha256": "150292ea6d42d20d501f61356ed55efa4c095f5bbdcff3999450818929af768b"
      }
    ]
  },
  "sections": [
    {
      "name": "Product",
      "description": "Marketplace (realmsgos.org), the fleet file registry, and the RLM token and NFT canisters. Realm stands are minted by GaaS, not by this orchestra.",
      "stands": [
        {
          "name": "marketplace",
          "canisters": [
            {
              "name": "marketplace-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "marketplace-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_file_registry_canister_id",
                  "args": "$canister:fleet-file-registry",
                  "converged_when": {
                    "query": "get_file_registry_canister_id_q",
                    "equals": "$canister:fleet-file-registry"
                  }
                },
                {
                  "method": "set_casals_frontend_canister_id",
                  "args": "$canister:casals-frontend",
                  "converged_when": {
                    "query": "get_casals_frontend_canister_id_q",
                    "equals": "$canister:casals-frontend"
                  }
                },
                {
                  "method": "admin_grant_publisher",
                  "args": {
                    "principal": "$principal:operator",
                    "duration_seconds": 315360000,
                    "note": "operator (sheet)",
                    "reviewer": true
                  },
                  "converged_when": {
                    "query": "admin_status",
                    "contains": {
                      "licensed": [
                        "$principal:operator"
                      ],
                      "reviewers": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "$comment": "First-party listings are created by the operator; this is the name the marketplace shows for it.",
                  "method": "admin_set_developer_name",
                  "args": {
                    "principal": "$principal:operator",
                    "name": "Realms GOS team"
                  },
                  "converged_when": {
                    "query": "admin_status",
                    "contains": {
                      "names": [
                        {
                          "principal": "$principal:operator",
                          "name": "Realms GOS team"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "name": "marketplace-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/marketplace-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"marketplace_backend\": \"$stand.backend\", \"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "file-registry",
          "description": "Fleet registry: extension packages, codices, catalogs, and the approvals the marketplace stamps.",
          "canisters": [
            {
              "name": "fleet-file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "*",
                    "principal": "$principal:operator"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "*": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "_approvers",
                    "principal": "$canister:marketplace-backend"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "_approvers": [
                        "$canister:marketplace-backend"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "name": "fleet-file-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/file-registry-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "token",
          "canisters": [
            {
              "name": "token-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "token-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms Token\"; symbol = \"RLM\"; decimals = 8 : nat8; total_supply = 100_000_000_000_000_000 : nat; fee = 10_000 : nat; test = opt false })"
            }
          ]
        },
        {
          "name": "nft",
          "canisters": [
            {
              "name": "nft-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "nft-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms NFT\"; symbol = \"RNFT\"; description = opt \"Realms NFT collection\"; supply_cap = null; test = opt false })"
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 5.0
  }
}
