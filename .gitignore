*.log
logs/*
!logs/.gitkeep
integration-test-logs/
playwright-report/
test-results/
coverage/
htmlcov/

# ── Scratch / debug ─────────────────────────────────────────────────────────
debug_files
deleteme*
HACK*
*temp

# ── Local dev process files ─────────────────────────────────────────────────
.dev.pid

# ── Generated realm workspaces (mundus installs) ────────────────────────────
.realms/

# ── CLI build artifacts ─────────────────────────────────────────────────────
cli/build/

# ── Legacy extension artifacts (extensions load dynamically at runtime) ───────
src/realm_backend/extension_packages/
src/realm_frontend/src/lib/extensions/
src/realm_frontend/src/routes/(sidebar)/extensions/
!src/realm_frontend/src/routes/(sidebar)/extensions/[id]/
src/realm_frontend/src/routes/(sidebar)/admin/
src/realm_frontend/src/routes/(sidebar)/monitor/
src/realm_frontend/src/routes/welcome/
src/realm_frontend/src/lib/i18n/locales/extensions/
src/realm_frontend/static/extensions/

# Deploy scripts may copy a realm's logo/background into static/custom for a
# sheet-realm build. Never commit those — a new realm must ship no brand.
src/realm_frontend/static/custom/logo.png
src/realm_frontend/static/custom/background.png

