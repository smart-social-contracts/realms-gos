{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "realms",
  "private": true,
  "scripts": {
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "prebuild:all": "npm run prebuild --workspaces --if-present",
    "build": "node -e \"console.log('root build is a no-op (dfx post-build shim); use npm run build:all')\""
  },
  "type": "module",
  "workspaces": [
    "packages/create-extension",
    "packages/extension-bridge",
    "packages/extension-ui",
    "src/realm_frontend",
    "src/marketplace_frontend",
    "src/platform_dashboard_frontend"
  ],
  "dependencies": {
    "@icp-sdk/core": "6.1.1",
    "svelte-markdown": "^0.4.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.27.0"
  },
  "overrides": {
    "@icp-sdk/signer": "6.1.0",
    "rollup": "^4.59.0",
    "esbuild": "0.21.5",
    "flatted": "^3.4.2",
    "immutable": "^5.1.6",
    "vite": {
      "esbuild": "0.21.5",
      "rollup": "^4.59.0"
    },
    "svelte-i18n": {
      "esbuild": "0.28.1"
    }
  }
}
