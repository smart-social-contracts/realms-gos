{
  "version": 2,
  "name": "realms-product",
  "description": "Realms product orchestra: the marketplace, the fleet file registry (extensions, codices, catalogs), and the RLM token and NFT canisters.",
  "environments": {
    "staging": {
      "network": "ic",
      "$comment": "Staging on mainnet. Operator is dev-identity. Hosts are staging.realmsgos.org and casals.staging.realmsgos.org.",
      "dns": {
        "provider": "cloudflare",
        "zone": "realmsgos.org",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "marketplace_host": "staging.realmsgos.org",
      "casals_host": "casals.staging.realmsgos.org",
      "principals": {
        "operator": "$deployer",
        "$comment_operator_code": "Unclaimed access-code slot. Whoever redeems it becomes a conductor commander with full access. The code is not stored in this file.",
        "operator_code": "sha256:bfefe7081c3ccf6dc36752e7461f4e98d8ceb4ff966a11a61cfdcb6b7b6cc13a",
        "$comment_deployer": "The identity that ran casals up. It is a controller of the governance multisig only.",
        "deployer": "$deployer"
      },
      "cycles": {
        "budget_tc": 15
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "files": {
        "/.well-known/casals.json": "{\"orchestra\":\"realms-product\",\"conductor\":\"$self\"}\n"
      },
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "store": {
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      },
      {
        "principal": "$principal:operator_code",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "realms-product"
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.7.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig",
        "$deployer"
      ]
    }
  },
  "domains": [
    {
      "host": "$env.marketplace_host",
      "canister": "marketplace-frontend"
    },
    {
      "host": "$env.casals_host",
      "canister": "casals-frontend"
    }
  ],
  "registry": {
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "release:smart-social-contracts/Casals@v0.7.0-rc21:casals_backend.wasm.gz",
        "sha256": "244487f7867f92e3e7f7b10e36817fa0bdc3f602bf21a4e1d76240546dc200c8"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "release:smart-social-contracts/Casals@v0.7.0-rc7:certified-assets@0.3.0.wasm.gz"
      },
      {
        "family": "ic-frontend",
        "version": "1.0.1",
        "source": "release:smart-social-contracts/ic-frontend@v1.0.1:ic-frontend@1.0.1.wasm.gz",
        "sha256": "feec64ef3ae77608b7399866d678532d4956c09121d06e00fb3e3b57d4ad8939"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.7.0",
        "source": "release:smart-social-contracts/Casals@v0.7.0-rc7:orchestration-multisig@1.7.0.wasm.gz"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "release:smart-social-contracts/file-registry@v0.1.2-rc1:file_registry.wasm.gz",
        "sha256": "9e6d85c8bf4695b38c3ae63b62a2636d54c5849073cc97e98e95415e8d1a7d21"
      },
      {
        "family": "marketplace-backend",
        "version": "0.8.0-rc3",
        "source": "release:smart-social-contracts/realms-gos@v0.8.0-rc3:marketplace-backend-v0.8.0-rc3.wasm.gz",
        "sha256": "d50e96b541276f57546a4a80637336e20f8595a989fa95294fa565276deead33"
      },
      {
        "family": "token-backend",
        "version": "0.1.0",
        "source": "release:smart-social-contracts/realms-gos@v0.7.0-rc6:token-backend-v0.7.0-rc6.wasm.gz",
        "sha256": "a1734ad2ec260ce85e541f860dbcaf8c846423709177587c7e5f70adc47e461a"
      },
      {
        "family": "nft-backend",
        "version": "0.1.0",
        "source": "release:smart-social-contracts/realms-gos@v0.7.0-rc6:nft-backend-v0.7.0-rc6.wasm.gz",
        "sha256": "abea08d97de800d4e299545be786dd02c9c6a7d93aaccc3770a08c213dfa484b"
      }
    ],
    "bundles": [
      {
        "path": "frontend/marketplace-assets/main",
        "source": "release:smart-social-contracts/realms-gos@v0.8.0-rc3:marketplace-frontend-v0.8.0-rc3.tar.gz",
        "sha256": "d0873e8f23d893955b689e0b02dffd79725158dc97bc6609d2b4317042c6fcd9"
      },
      {
        "path": "frontend/file-registry-assets/main",
        "source": "release:smart-social-contracts/file-registry@v0.1.2-rc1:file_registry_frontend.tar.gz",
        "sha256": "89a6268f4d29f5ad6ac6b7930dc18d6dd8c3f4adc5c72e633e493dbb17044806"
      },
      {
        "path": "frontend/casals-ui/main",
        "source": "release:smart-social-contracts/Casals@v0.7.0-rc21:casals_frontend.tar.gz",
        "sha256": "de5ab6b3e12e4c1bf0e7ec2d4f38b1618372314fe64c7b5777d3946550edee73"
      }
    ]
  },
  "sections": [
    {
      "name": "Product",
      "description": "Marketplace (realmsgos.org), the fleet file registry, and the RLM token and NFT canisters. Realm stands are minted by GaaS, not by this orchestra.",
      "stands": [
        {
          "name": "marketplace",
          "canisters": [
            {
              "name": "marketplace-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "marketplace-backend@0.8.0-rc3",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_file_registry_canister_id",
                  "args": "$canister:fleet-file-registry",
                  "converged_when": {
                    "query": "get_file_registry_canister_id_q",
                    "equals": "$canister:fleet-file-registry"
                  }
                },
                {
                  "method": "set_casals_frontend_canister_id",
                  "args": "$canister:casals-frontend",
                  "converged_when": {
                    "query": "get_casals_frontend_canister_id_q",
                    "equals": "$canister:casals-frontend"
                  }
                },
                {
                  "method": "admin_grant_publisher",
                  "args": {
                    "principal": "$principal:operator",
                    "duration_seconds": 315360000,
                    "note": "operator (sheet)",
                    "reviewer": true
                  },
                  "converged_when": {
                    "query": "admin_status",
                    "contains": {
                      "licensed": [
                        "$principal:operator"
                      ],
                      "reviewers": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "$comment": "First-party listings are created by the operator; this is the name the marketplace shows for it.",
                  "method": "admin_set_developer_name",
                  "args": {
                    "principal": "$principal:operator",
                    "name": "Realms GOS team"
                  },
                  "converged_when": {
                    "query": "admin_status",
                    "contains": {
                      "names": [
                        {
                          "principal": "$principal:operator",
                          "name": "Realms GOS team"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "name": "marketplace-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "ic-frontend@1.0.1",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/marketplace-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"marketplace_backend\": \"$stand.backend\", \"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "file-registry",
          "description": "Fleet registry: extension packages, codices, catalogs, and the approvals the marketplace stamps.",
          "canisters": [
            {
              "name": "fleet-file-registry",
              "public": true,
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "*",
                    "principal": "$principal:operator"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "*": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "_approvers",
                    "principal": "$canister:marketplace-backend"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "_approvers": [
                        "$canister:marketplace-backend"
                      ]
                    }
                  }
                },
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "_granters",
                    "principal": "$canister:marketplace-backend"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "_granters": [
                        "$canister:marketplace-backend"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "name": "fleet-file-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "ic-frontend@1.0.1",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/file-registry-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "token",
          "canisters": [
            {
              "name": "token-backend",
              "public": true,
              "kind": "backend",
              "mode": "managed",
              "wasm": "token-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms Token\"; symbol = \"RLM\"; decimals = 8 : nat8; total_supply = 100_000_000_000_000_000 : nat; fee = 10_000 : nat; test = opt false })"
            }
          ]
        },
        {
          "name": "nft",
          "canisters": [
            {
              "name": "nft-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "nft-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms NFT\"; symbol = \"RNFT\"; description = opt \"Realms NFT collection\"; supply_cap = null; test = opt false })"
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "backend": {
      "min_balance_tc": 1.0
    },
    "top_up_from": "$self",
    "conductor_min_balance_tc": 5.0
  }
}
