{
  "name": "marketplace_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm i && dfx canister create marketplace_backend && dfx generate marketplace_backend && dfx deploy",
    "start": "vite --port 3002",
    "prebuild": "node scripts/check-declarations.mjs",
    "build": "vite build",
    "postbuild": "node scripts/write-version-file.js",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts && node --test ../../scripts/build-info.test.js",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts && node --test ../../scripts/build-info.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss,svelte}\""
  },
  "dependencies": {
    "@icp-sdk/auth": "11.2.0",
    "@icp-sdk/core": "6.1.1",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@sveltejs/adapter-static": "^3.0.4",
    "@sveltejs/kit": "^2.5.26",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "dotenv": "^16.3.1",
    "sass": "^1.63.6",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.3",
    "vite-plugin-environment": "^1.1.3"
  }
}
