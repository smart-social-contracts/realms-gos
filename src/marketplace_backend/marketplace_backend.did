type FileRegistryService = service { set_namespace_approval : (text) -> (text) };
type QuarterDirectoryService = service { get_quarter_directory : () -> (text) query };
type PositionHoldersService = service { list_position_holders : () -> (text) query };
type CapitalPopulationService = service { report_quarter_population : (nat) -> (text); report_quarter_ready : () -> (text) };
type DemoRegistrationService = service { register_demo_citizens : (text) -> (text) };
type FederationService = service { federation_message : (text) -> (text) };
type AssetCanisterService = service { store : (_AssetStoreArg) -> (); list : (_ListAssetsArg) -> (text) query; delete_asset : (_DeleteAssetArg) -> () };
type RealmMessagingService = service { receive_realm_message : (text, text, text, text) -> (text) };
type NFTService = service { mint : (MintArg) -> (MintResult); force_transfer : (ForceTransferArg) -> (AuthorityResult); freeze_token : (FreezeArg) -> (AuthorityResult); unfreeze_token : (nat) -> (AuthorityResult) };
type CasalsService = service { create_stand : (text) -> (text); get_bindings : () -> (text) query };
type QuarterBootstrapService = service { bootstrap_as_quarter : (text) -> (text) };
type QuarterCodexSyncService = service { request_codex_sync : (text) -> (text) };
type RealmRegistryService = service { register_realm : (text, text, text, text, text) -> (AddRealmResult) };
type TokenAuthorityService = service { forced_transfer : (ForcedTransferArgs) -> (TokenAuthorityResult); freeze_account : (FreezeAccountArgs) -> (TokenAuthorityResult); unfreeze_account : (TokenAccount) -> (TokenAuthorityResult) };
type Icrc1MetadataService = service { icrc1_symbol : () -> (text) query; icrc1_name : () -> (text) query; icrc1_decimals : () -> (nat8) query };
type RealmRegistryUpgradeService = service { request_upgrade : (text) -> (text); get_credits : (text) -> (GetCreditsResult) query; get_latest_version : () -> (UpgradeResult) query };
type _ICRC1IndexerService = service { get_account_transactions : (_GetAccountTransactionsArgs) -> (_GetAccountTransactionsResult) query };

service : (opt MarketplaceInitArg) -> {
  "status" : () -> (StatusResult) query;
  "get_marketplace_config" : () -> (ConfigResult) query;
  "get_file_registry_canister_id_q" : () -> (text) query;
  "set_file_registry_canister_id" : (text) -> (GenericResult);
  "get_casals_frontend_canister_id_q" : () -> (text) query;
  "set_casals_frontend_canister_id" : (text) -> (GenericResult);
  "list_reviewers" : () -> (vec text) query;
  "add_reviewer" : (text) -> (GenericResult);
  "remove_reviewer" : (text) -> (GenericResult);
  "review_listing" : (text, text, bool, text) -> (text);
  "admin_approve_namespace" : (text, text) -> (text);
  "get_billing_service_principal_q" : () -> (text) query;
  "set_billing_service_principal" : (text) -> (GenericResult);
  "get_license_pricing_q" : () -> (LicensePricingRecord) query;
  "set_license_pricing" : (nat64, nat64) -> (GenericResult);
  "create_extension" : (ExtensionInput) -> (GenericResult);
  "update_extension" : (ExtensionInput) -> (GenericResult);
  "delist_extension" : (text) -> (GenericResult);
  "get_extension_details" : (text) -> (ExtensionResult) query;
  "list_marketplace_extensions" : (nat64, nat64, bool) -> (ExtensionListResult) query;
  "search_extensions" : (text, bool) -> (vec ExtensionListing) query;
  "get_my_extensions" : () -> (vec ExtensionListing) query;
  "create_codex" : (CodexInput) -> (GenericResult);
  "update_codex" : (CodexInput) -> (GenericResult);
  "delist_codex" : (text) -> (GenericResult);
  "get_codex_details" : (text) -> (CodexResult) query;
  "list_marketplace_codices" : (nat64, nat64, bool) -> (CodexListResult) query;
  "search_codices" : (text, bool) -> (vec CodexListing) query;
  "get_my_codices" : () -> (vec CodexListing) query;
  "create_assistant" : (AssistantInput) -> (GenericResult);
  "update_assistant" : (AssistantInput) -> (GenericResult);
  "delist_assistant" : (text) -> (GenericResult);
  "get_assistant_details" : (text) -> (AssistantResult) query;
  "list_marketplace_assistants" : (nat64, nat64, bool) -> (AssistantListResult) query;
  "search_assistants" : (text, bool) -> (vec AssistantListing) query;
  "get_my_assistants" : () -> (vec AssistantListing) query;
  "buy_extension" : (text) -> (GenericResult);
  "buy_codex" : (text) -> (GenericResult);
  "buy_assistant" : (text) -> (GenericResult);
  "has_purchased_extension" : (text, text) -> (bool) query;
  "has_purchased_codex" : (text, text) -> (bool) query;
  "has_purchased_assistant" : (text, text) -> (bool) query;
  "get_my_purchases" : () -> (vec PurchaseRecord) query;
  "like_item" : (text, text) -> (GenericResult);
  "unlike_item" : (text, text) -> (GenericResult);
  "has_liked" : (text, text, text) -> (bool) query;
  "my_likes" : () -> (vec LikeRecord) query;
  "recount_listing_likes" : () -> (GenericResult);
  "top_extensions_by_downloads" : (nat64, bool) -> (vec ExtensionListing) query;
  "top_extensions_by_likes" : (nat64, bool) -> (vec ExtensionListing) query;
  "top_codices_by_downloads" : (nat64, bool) -> (vec CodexListing) query;
  "top_codices_by_likes" : (nat64, bool) -> (vec CodexListing) query;
  "top_assistants_by_downloads" : (nat64, bool) -> (vec AssistantListing) query;
  "top_assistants_by_likes" : (nat64, bool) -> (vec AssistantListing) query;
  "check_license" : (text) -> (LicenseResult) query;
  "get_license_status" : () -> (LicenseResult) query;
  "record_license_payment" : (LicensePaymentInput) -> (GenericResult);
  "grant_manual_license" : (text, nat64, text) -> (GenericResult);
  "admin_grant_publisher" : (text) -> (text);
  "admin_set_developer_name" : (text) -> (text);
  "transfer_listing" : (text, text, text) -> (GenericResult);
  "admin_status" : () -> (text) query;
  "revoke_license" : (text) -> (GenericResult);
  "request_audit" : (text, text) -> (GenericResult);
  "set_verification_status" : (text, text, text, text) -> (GenericResult);
  "list_pending_audits" : () -> (vec PendingAudit) query;
  "greet" : (text) -> (text) query;
  "http_request" : (HttpRequest) -> (HttpResponseIncoming) query;
  "http_request_update" : (HttpRequest) -> (HttpResponseIncoming);
  "__get_candid_interface_tmp_hack" : () -> (text) query;
}
