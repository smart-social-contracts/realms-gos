      "declarations": {
        "node_compatibility": true
      },
      "gzip": true,
      "metadata": [
        {
          "name": "candid:service"
        }
      ],
      "tech_stack": {
        "cdk": {
          "basilisk": {}
        },
        "language": {
          "python": {}
        }
      },
      "type": "custom",
      "wasm": ".basilisk/realm_backend/realm_backend.wasm"
    },
    "realm_frontend": {
      "source": [
        "src/realm_frontend/dist"
