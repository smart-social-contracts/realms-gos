        "node_compatibility": true
      },
      "gzip": true,
      "metadata": [
        {
          "name": "candid:service"
        }
      ],
      "tech_stack": {
        "cdk": {
          "basilisk": {}
        },
        "language": {
          "python": {}
        }
      },
      "type": "custom",
      "wasm": ".basilisk/marketplace_backend/marketplace_backend.wasm"
    },
    "marketplace_frontend": {
      "source": [
        "src/marketplace_frontend/dist"
      ],
      "type": "assets",
      "workspace": "marketplace_frontend",
      "dependencies": [
        "marketplace_backend"
