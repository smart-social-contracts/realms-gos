    "nft_frontend": {
      "type": "assets",
      "source": [],
      "remote": {
        "id": {
          "demo": "6aqo3-fqaaa-aaaaf-qdohq-cai",
          "test": "ysrkl-eqaaa-aaaas-qgosa-cai"
        }
      }
