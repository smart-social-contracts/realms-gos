      "type": "assets"
    },
    "internet_identity": {
      "candid": "https://github.com/dfinity/internet-identity/releases/download/release-2026-03-09/internet_identity.did",
      "frontend": {},
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      },
      "type": "custom",
      "wasm": "https://github.com/dfinity/internet-identity/releases/download/release-2026-03-09/internet_identity_dev.wasm.gz"
    },
    "ckbtc_ledger": {
      "type": "custom",
      "candid": "https://github.com/dfinity/ic/releases/download/ledger-suite-icrc-2025-02-27/ledger.did",
      "wasm": "https://github.com/dfinity/ic/releases/download/ledger-suite-icrc-2025-02-27/ic-icrc1-ledger.wasm.gz",
      "remote": {
        "id": {
          "ic": "mxzaz-hqaaa-aaaar-qaada-cai"
        }
      },
      "init_arg": "(variant { Init = record { token_name = \"ckBTC\"; token_symbol = \"ckBTC\"; minting_account = record { owner = principal \"aaaaa-aa\" }; initial_balances = vec {}; metadata = vec {}; transfer_fee = 10; archive_options = record { trigger_threshold = 2000; num_blocks_to_archive = 1000; controller_id = principal \"aaaaa-aa\" }; feature_flags = opt record { icrc2 = true }; } })"
    },
    "ckbtc_indexer": {
      "type": "custom",
      "candid": "https://github.com/dfinity/ic/releases/download/ledger-suite-icrc-2025-02-27/index-ng.did",
      "wasm": "https://github.com/dfinity/ic/releases/download/ledger-suite-icrc-2025-02-27/ic-icrc1-index-ng.wasm.gz",
      "remote": {
        "id": {
          "ic": "n5wcd-faaaa-aaaar-qaaea-cai"
        }
      },
      "init_arg": "(opt variant { Init = record { ledger_id = principal \"aaaaa-aa\" } })"
    },
    "token_backend": {
      "type": "custom",
      "candid": "https://github.com/smart-social-contracts/ic-python-token/releases/download/v0.6.0/token_backend.did",
      "wasm": "https://github.com/smart-social-contracts/ic-python-token/releases/download/v0.6.0/token_backend.wasm.gz",
      "remote": {
        "id": {
          "demo": "xbkkh-syaaa-aaaah-qq3ya-cai",
          "test": "nusyl-jiaaa-aaaae-qj6mq-cai"
        }
      },
      "init_arg": "(record { name = \"Simple Token\"; symbol = \"SMPL\"; decimals = 8 : nat8; total_supply = 100_000_000_000_000_000 : nat; fee = 10_000 : nat; test = opt true })"
    },
    "token_frontend": {
      "type": "assets",
      "source": [],
      "remote": {
        "id": {
          "demo": "xglmt-7aaaa-aaaah-qq3yq-cai",
          "test": "33mmr-pyaaa-aaaam-ai47q-cai"
        }
      }
    },
    "nft_backend": {
      "type": "custom",
      "candid": "https://github.com/smart-social-contracts/ic-tokens/releases/download/v0.1.0/nft_backend.did",
      "wasm": "https://github.com/smart-social-contracts/ic-tokens/releases/download/v0.1.0/nft_backend.wasm",
      "remote": {
        "id": {
          "demo": "6hrip-iiaaa-aaaaf-qdoha-cai",
          "test": "eelas-yyaaa-aaaao-qps7a-cai"
